{
  "name": "done-ish",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "start": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "setup": "yarn install --frozen-lockfile && yarn setup:python && yarn test:e2e:install",
    "setup:python": "python3 -m venv backend/.venv && backend/.venv/bin/python -m pip install -r backend/requirements-dev.txt",
    "lint": "yarn lint:js && yarn lint:css && yarn lint:python",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"styles/**/*.css\" \"src/**/*.css\"",
    "lint:python": "backend/.venv/bin/ruff check backend/scripts",
    "format": "prettier --write . && backend/.venv/bin/ruff format backend/scripts",
    "format:check": "prettier --check . && backend/.venv/bin/ruff format --check backend/scripts",
    "quality": "yarn lint && yarn format:check && yarn test && yarn build",
    "test": "yarn test:unit && yarn test:api && yarn test:e2e",
    "test:api": "yarn --cwd backend/api test",
    "test:unit": "python3 -m unittest backend.scripts.test_update_catalogs && node --test backend/scripts/test_catalogs.mjs backend/scripts/test_catalog_seed.mjs && node scripts/audit_repo.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "audit": "node scripts/audit_repo.mjs",
    "db:catalogs:seed": "node backend/scripts/build_catalog_seed.mjs",
    "db:generate": "drizzle-kit generate --config=backend/drizzle.config.ts",
    "deploy:pi": "sh backend/scripts/deploy_raspberry_pi.sh",
    "update:catalogs": "python3 backend/scripts/update_catalogs.py"
  },
  "dependencies": {
    "vue": "^3.5.41",
    "vue-router": "4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^7.3.6",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "yarn@1.22.22"
}

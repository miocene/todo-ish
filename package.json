{
  "name": "done-ish",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "start": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "setup": "yarn install --frozen-lockfile && yarn setup:python && yarn test:e2e:install",
    "setup:python": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.txt",
    "lint": "yarn lint:js && yarn lint:css && yarn lint:python",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint variables.css normalisation.css styles.css \"src/**/*.css\"",
    "lint:python": ".venv/bin/ruff check scripts",
    "format": "prettier --write . && .venv/bin/ruff format scripts",
    "format:check": "prettier --check . && .venv/bin/ruff format --check scripts",
    "quality": "yarn lint && yarn format:check && yarn test && yarn build",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "python3 -m unittest scripts.test_update_catalogs && node --test scripts/test_domain.mjs scripts/test_persistence.mjs scripts/test_catalogs.mjs && node scripts/audit_repo.mjs && node scripts/audit_css.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "audit": "node scripts/audit_repo.mjs && node scripts/audit_css.mjs",
    "update:catalogs": "python3 scripts/update_catalogs.py"
  },
  "dependencies": {
    "vue": "^3.5.41",
    "vue-router": "4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^7.3.6",
    "vue-eslint-parser": "^10.4.1"
  },
  "packageManager": "yarn@1.22.22"
}
